# LLM Provider API Keys (set at least one)
# Supported via LiteLLM: OpenAI, Anthropic, Gemini, Groq, Ollama, Azure, etc.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Model Selection
# Examples: gemini/gemini-3.6-flash, gemini/gemini-3.6-flash, claude-sonnet-4-20250514, ollama/llama3
MODEL_NAME=gemini/gemini-3.6-flash

# Agent Behaviour
MAX_ITERATIONS=3
EXECUTION_TIMEOUT_SECONDS=10
TEMPERATURE=0.2

# Persistence
MEMORY_STORAGE_PATH=./data/reflections.json
